---
import { Tabs, TabItem } from '@astrojs/starlight/components';

// Get all the named slots
const hasUsage = Astro.slots.has('usage');
const hasParams = Astro.slots.has('params');
const hasExamples = Astro.slots.has('examples');
const hasPermissions = Astro.slots.has('permissions');

// Only render Tabs if at least one slot is provided
const hasAnySlot = hasUsage || hasParams || hasExamples || hasPermissions;
---

{hasAnySlot && (
    <Tabs>
        {hasUsage && (
            <TabItem label="Usage" icon="forward-slash">
                <slot name="usage" />
            </TabItem>
        )}
        {hasParams && (
            <TabItem label="Parameters" icon="setting">
                <slot name="params" />
            </TabItem>
        )}
        {hasExamples && (
            <TabItem label="Examples" icon="list-format">
                <slot name="examples" />
            </TabItem>
        )}
        {hasPermissions && (
            <TabItem label="Permissions" icon="approve-check-circle">
                <slot name="permissions" />
            </TabItem>
        )}
    </Tabs>
)}
